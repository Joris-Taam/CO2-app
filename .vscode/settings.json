//NOTE: We want to disable all auto-formatting/auto-fixing and AI for our students
{
    "eslint.format.enable": true,
    "editor.defaultFormatter": "dbaeumer.vscode-eslint",
    "debug.onTaskErrors": "abort",
    "debug.terminal.clearBeforeReusing": true,
    "editor.rulers": [
        110
    ],
    "editor.formatOnSave": false,
    "editor.codeActionsOnSave": {
        "source.fixAll": "never"
    },
    "lit-plugin.htmlTemplateTags": [
        "html",
        "htmlArray"
    ],
    "lit-plugin.rules.no-complex-attribute-binding": "off",
    "npm.packageManager": "npm",
    "github.copilot.enable": {
        "*": false,
        "plaintext": false,
        "markdown": false,
        "scminput": false,
        "typescript": true
    },
    "html.format.indentInnerHtml": true,
    "html.format.maxPreserveNewLines": 1,
    "html.format.wrapLineLength": 0,
    "html.format.templating": true,
    "html.format.extraLiners": "",
    "explorer.compactFolders": false,
    "workbench.tree.indent": 16,
    "postman.settings.dotenv-detection-notification-visibility": false,
    "[sql]": {
        "editor.defaultFormatter": "cweijan.vscode-database-client2"
    }
}
