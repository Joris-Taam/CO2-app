{
    "ci": {
        "collect": {
            "numberOfRuns": 1,
            "staticDistDir": "dist/web",
            "settings": {
                "chromeFlags": "--no-sandbox"
            }
        },
        "assert": {
            "assertions": {
                "categories:performance": ["error", { "minScore": 0.5 }],
                "categories:accessibility": ["error", { "minScore": 0.5 }]
            }
        },
        "upload": {
            "target": "filesystem",
            "outputDir": ".lighthouseci"
        }
    }
}
